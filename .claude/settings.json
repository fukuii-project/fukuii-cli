{
  "permissions": {
    "allow": [
      "Bash(bash .local/scratch/*)",
      "Bash(sbt compile)",
      "Bash(sbt testFull)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.keystore)",
      "Read(./**/*.p12)",
      "Read(UTC--*)",
      "Read(**/*.jks)",
      "Read(**/*.pfx)",
      "Read(nodekey)",
      "Read(jwtsecret)",
      "Read(jwt.hex)",
      "Read(wallet.json)",
      "Read(mnemonic.txt)",
      "Read(**/*.credentials)",
      "Read(.netrc)",
      "Read(.envrc)",
      "Read(.git-credentials)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/rules-on-create.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/comment-policy.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
